# Copie este archivo a .env y complete los valores. El .env real NO se sube a Git.
DB_NAME=alumnos_db
DB_USER=eduspace
DB_PASSWORD=cambiar-esta-clave
CONFIG_SERVER_URL=http://config-server:8888
MINIO_ENDPOINT=http://minio:9000
